rules_version = '2';

// Regras do Firestore da Dos Reis Barbearia.
// Publique no Console do Firebase > Firestore Database > Regras
// (ou com a Firebase CLI: `firebase deploy --only firestore:rules`).

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = qualquer usuário logado. As contas são criadas só pelo Console do Firebase
    // (deixe a criação de contas pelo site DESATIVADA em Authentication > Configurações).
    function isAdmin() {
      return request.auth != null;
    }

    function serviceNames() {
      return ['Corte de cabelo', 'Barba', 'Pezinho', 'Sobrancelha', 'Luzes'];
    }

    // Terça a sábado, 08:00 a 19:40 em intervalos de 20 min, até ~65 dias à frente (o site oferece 60).
    function validDateTime(date, time) {
      let p = date.split('-');
      let day = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && time.matches('^(0[89]|1[0-9]):(00|20|40)$')
        && day.dayOfWeek() >= 2 && day.dayOfWeek() <= 6   // 1 = segunda ... 7 = domingo
        && day > request.time - duration.value(1, 'd')
        && day < request.time + duration.value(65, 'd');
    }

    // Horários ocupados: públicos para leitura, sem dados pessoais.
    // Só podem ser CRIADOS (nunca sobrescritos), o que impede dois agendamentos no mesmo horário.
    match /slots/{slotId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['date', 'time', 'appointmentId', 'createdAt'])
        && request.resource.data.keys().hasAll(['date', 'time', 'appointmentId', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.appointmentId is string
        && slotId == request.resource.data.date + '_' + request.resource.data.time
        && validDateTime(request.resource.data.date, request.resource.data.time)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotId == slotId;

      // Admin pode liberar um horário (ex: cancelamento).
      allow delete: if isAdmin();
    }

    function validAppointment(id, d) {
      return d.keys().hasOnly(['name', 'phone', 'service', 'date', 'time', 'slotId', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'service', 'date', 'time', 'slotId', 'status', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.phone is string && d.phone.matches('^[0-9]{10,11}$')
        && d['service'] in serviceNames()   // "service" é palavra reservada nas regras; por isso o acesso com colchetes
        && d.status == 'scheduled'
        && d.date is string && d.time is string
        && d.slotId == d.date + '_' + d.time
        && d.createdAt == request.time
        && getAfter(/databases/$(database)/documents/slots/$(d.slotId)).data.appointmentId == id;
    }

    // Agendamentos com nome e telefone: qualquer um pode criar, só admin lê/edita/apaga.
    match /appointments/{appointmentId} {
      allow create: if validAppointment(appointmentId, request.resource.data);
      allow read, update, delete: if isAdmin();
    }
  }
}
